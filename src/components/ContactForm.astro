---
import { href } from '../lib/links';

// POSTs to the platform's form endpoint on this site's own origin.
// Contract (do not change): the action path __forms/<name>, the hidden `_hp`
// honeypot field, and `_next` (same-site redirect after success). Underscore-
// prefixed field names are reserved for the platform and never stored.
---

<form method="POST" action={href('__forms/contact')}>
  <input type="hidden" name="_next" value={href('contact/thanks/')} />
  <div class="hp" aria-hidden="true">
    <label>Website<input type="text" name="_hp" tabindex="-1" autocomplete="off" /></label>
  </div>

  <label>
    Your name
    <input type="text" name="name" required maxlength="120" autocomplete="name" />
  </label>
  <label>
    Email
    <input type="email" name="email" required maxlength="200" autocomplete="email" />
  </label>
  <label>
    Message
    <textarea name="message" required rows="6" maxlength="2000"></textarea>
  </label>
  <button type="submit">Send message</button>
</form>

<style>
  form {
    display: grid;
    gap: var(--space-4);
    max-width: 32rem;
  }

  label {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  input,
  textarea {
    font: inherit;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-3);
  }

  input:focus,
  textarea:focus {
    outline: 2px solid var(--brand);
    outline-offset: 1px;
    border-color: var(--brand);
  }

  button {
    justify-self: start;
    font: inherit;
    font-weight: 600;
    color: var(--n-0);
    background: var(--brand);
    border: none;
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-6);
    cursor: pointer;
  }

  button:hover {
    background: var(--brand-strong);
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
