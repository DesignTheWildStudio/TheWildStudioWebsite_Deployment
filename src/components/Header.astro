---
import { href } from '../lib/links';

const links = [
  { href: href(''), label: 'Home' },
  { href: href('about/'), label: 'About' },
  { href: href('blog/'), label: 'Blog' },
  { href: href('contact/'), label: 'Contact' },
];
---

<header>
  <div class="inner">
    <a class="brand" href={href('')}>Clearview Consulting</a>
    <nav aria-label="Main">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .brand {
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--heading);
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: var(--space-6);
  }

  nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  nav a:hover {
    color: var(--brand);
  }
</style>
